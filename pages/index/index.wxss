/* 全屏容器 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰圆 */
.bg-decoration {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 100rpx;
  left: -150rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  bottom: -50rpx;
  right: 50rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  z-index: 1;
}

.logo-box {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 72rpx;
}

.app-name {
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.2);
  z-index: 1;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 50rpx;
}

/* 头像选择 */
.avatar-picker {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 2rpx dashed #c0c4cc;
  padding: 0;
  margin: 0;
  overflow: hidden;
  position: relative;
}

.avatar-btn::after {
  border: none;
}

.avatar-slot {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.avatar-plus {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.avatar-tip {
  font-size: 22rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 昵称 input */
.nickname-input {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  width: 100rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 100%;
}

/* 步骤行 */
.step-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.step-row:last-of-type {
  border-bottom: none;
  margin-bottom: 30rpx;
}

.step-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8eaf6;
  color: #667eea;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.step-row.done .step-no {
  background: linear-gradient(135deg, #07c160 0%, #00a854 100%);
  color: #fff;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.step-value {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  min-height: 36rpx;
}

.step-value.muted {
  color: #bbb;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #eee;
}

.nickname {
  font-size: 26rpx;
  color: #333;
}

.step-btn {
  background: #667eea;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border: none;
  flex-shrink: 0;
}
.step-btn::after {
  border: none;
}

/* 登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  height: 96rpx;
  line-height: 96rpx;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.login-btn[disabled] {
  background: #ccc;
  color: #fff;
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

.login-btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

/* 用户协议 */
.tips-row {
  display: flex;
  justify-content: center;
  align-items: center;
}

.tips {
  font-size: 24rpx;
  color: #999;
}

.link {
  font-size: 24rpx;
  color: #667eea;
  margin-left: 6rpx;
}