<view class="login-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-box">
      <text class="logo-icon">📷</text>
    </view>
    <text class="app-name">轻简相册</text>
    <text class="app-slogan">记录生活，分享美好</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-title">完善资料</view>
    <view class="card-desc">选头像、填昵称、选地区后即可登录</view>

    <!-- 步骤 1：选头像 + 填昵称（chooseAvatar） -->
    <view class="step-row {{step >= 2 ? 'done' : ''}}">
      <view class="step-no">{{step >= 2 ? '✓' : '1'}}</view>
      <view class="step-content">
        <view class="step-label">头像 & 昵称</view>
        <view class="step-value" wx:if="{{avatarUrl}}">
          <image class="avatar" src="{{avatarUrl}}"></image>
          <text class="nickname" wx:if="{{nickname}}">{{nickname}}</text>
          <text class="muted" wx:else>已选头像，请填昵称</text>
        </view>
        <view class="step-value muted" wx:else>未选择</view>
      </view>
    </view>

    <!-- 头像选择 button（open-type=chooseAvatar） -->
    <view class="avatar-picker" wx:if="{{step < 2}}">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <view class="avatar-slot" wx:if="{{!avatarUrl}}">
          <text class="avatar-plus">+</text>
          <text class="avatar-tip">选头像</text>
        </view>
        <image wx:else class="avatar-preview" src="{{avatarUrl}}"></image>
      </button>
    </view>

    <!-- 昵称 input -->
    <view class="nickname-input" wx:if="{{step < 2 || step === 2}}">
      <text class="input-label">昵称</text>
      <input
        class="input-field"
        type="nickname"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        placeholder="请输入您的昵称"
        maxlength="20"
        confirm-type="done"
      />
    </view>

    <!-- 步骤 2：省市区 picker -->
    <view class="step-row {{step >= 3 ? 'done' : ''}}">
      <view class="step-no">{{step >= 3 ? '✓' : '2'}}</view>
      <view class="step-content">
        <view class="step-label">所在地区</view>
        <view class="step-value muted" wx:if="{{!region[0]}}">未选择</view>
        <view class="step-value" wx:else>{{regionText}}</view>
      </view>
      <picker mode="region" bindchange="onRegionChange" wx:if="{{step >= 2 && step < 3}}">
        <view class="step-btn">选择</view>
      </picker>
    </view>

    <!-- 步骤 3：登录提交 -->
    <button
      class="login-btn"
      bindtap="onSubmit"
      disabled="{{step !== 3 || submitting}}"
    >
      {{submitting ? '登录中...' : '微信一键登录'}}
    </button>

    <view class="tips-row">
      <text class="tips">登录即表示同意</text>
      <text class="link">《用户协议》</text>
    </view>
  </view>
</view>
