<view class="login-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-box">
      <text class="logo-icon">📷</text>
    </view>
    <text class="app-name">轻简相册</text>
    <text class="app-slogan">记录生活，分享美好</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-title">欢迎回来</view>
    <view class="card-desc">授权微信后填写地区，即可登录</view>

    <!-- 步骤 1：微信授权（拿昵称 + 头像） -->
    <view class="step-row {{step >= 2 ? 'done' : ''}}">
      <view class="step-no">{{step >= 2 ? '✓' : '1'}}</view>
      <view class="step-content">
        <view class="step-label">微信授权</view>
        <view class="step-value" wx:if="{{nickname}}">
          <image class="avatar" src="{{avatarUrl}}"></image>
          <text class="nickname">{{nickname}}</text>
        </view>
        <view class="step-value muted" wx:else>未授权</view>
      </view>
      <button
        class="step-btn"
        open-type="getUserInfo"
        bindtap="onWxLogin"
        wx:if="{{step < 2}}"
      >授权</button>
    </view>

    <!-- 步骤 2：省市区 picker -->
    <view class="step-row {{step >= 3 ? 'done' : ''}}">
      <view class="step-no">{{step >= 3 ? '✓' : '2'}}</view>
      <view class="step-content">
        <view class="step-label">所在地区</view>
        <view class="step-value muted" wx:if="{{!region[0]}}">未选择</view>
        <view class="step-value" wx:else>{{regionText}}</view>
      </view>
      <picker mode="region" bindchange="onRegionChange" wx:if="{{step >= 2 && step < 3}}">
        <view class="step-btn">选择</view>
      </picker>
    </view>

    <!-- 步骤 3：登录提交 -->
    <button
      class="login-btn"
      bindtap="onSubmit"
      disabled="{{step !== 3 || submitting}}"
    >
      {{submitting ? '登录中...' : '微信一键登录'}}
    </button>

    <view class="tips-row">
      <text class="tips">登录即表示同意</text>
      <text class="link">《用户协议》</text>
    </view>
  </view>
</view>
