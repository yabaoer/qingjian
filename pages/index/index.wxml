<view class="login-page">
  <!-- 顶部渐变背景 -->
  <view class="hero">
    <view class="hero-deco hero-deco-1"></view>
    <view class="hero-deco hero-deco-2"></view>
    <view class="hero-deco hero-deco-3"></view>
    <view class="brand">
      <view class="brand-logo">📷</view>
      <text class="brand-name">轻简相册</text>
      <text class="brand-slogan">记录生活 · 分享美好</text>
    </view>
  </view>

  <!-- 资料卡（浮在 hero 底部） -->
  <view class="card">
    <text class="card-title">完善资料</text>
    <text class="card-sub">选头像 + 填昵称后即可登录</text>

    <!-- 头像选择 -->
    <view class="avatar-row">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="none"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">+</text>
          <text class="avatar-text">选头像</text>
        </view>
      </button>
      <view class="avatar-hint">
        <text wx:if="{{avatarUrl}}" class="hint-done">✓ 头像已选</text>
        <text wx:else class="hint-todo">点击选择头像</text>
      </view>
    </view>

    <!-- 昵称输入 -->
    <view class="input-block">
      <text class="input-label">昵称</text>
      <input
        class="input-field"
        type="nickname"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        placeholder="请输入您的昵称"
        maxlength="20"
        confirm-type="done"
        placeholder-class="input-placeholder"
      />
    </view>

    <!-- 登录按钮 -->
    <button
      class="submit-btn {{canSubmit ? 'active' : ''}}"
      bindtap="onSubmit"
      disabled="{{!canSubmit}}"
      hover-class="none"
    >
      <text wx:if="{{submitting}}">登录中...</text>
      <text wx:else>微信一键登录</text>
    </button>

    <view class="agreement">
      <text>登录即表示同意</text>
      <text class="agreement-link">《用户协议》</text>
    </view>
  </view>
</view>
